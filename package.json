{
  "name": "gitdonkey",
  "productName": "GitDonkey",
  "version": "1.5.2",
  "description": "A free, open-source desktop Git client: commit graph, staging, merges and conflict resolution in a patched-modular-synth skin.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/unit/*.test.*\"",
    "test:e2e": "node test/e2e/run.js && node test/e2e/updates.js && node test/e2e/themes.js && node test/e2e/donkey.js && node test/e2e/conflicts.js && node test/e2e/diffnav.js && node test/e2e/features.js",
    "dist": "electron-packager . GitDonkey --platform=darwin --arch=arm64 --out=dist --overwrite --icon=assets/icon --app-bundle-id=dev.gitdonkey.app --ignore=^/test --ignore=^/dist --ignore=^/\\.impeccable --ignore=^/scripts --ignore=^/demo --ignore=\\.impeccable --ignore=^/PRODUCT\\.md --ignore=^/assets/brand-sheet\\.png",
    "brand": "electron scripts/build-brand.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:linux": "docker run --rm -v \"$PWD\":/src:ro -v \"$PWD/dist\":/out node:22-bookworm bash /src/scripts/linux/build.sh",
    "dist:linux:native": "electron-builder --linux AppImage deb --x64 --arm64 --publish never",
    "test:linux": "docker run --rm -v \"$PWD/dist\":/out -v \"$PWD/scripts/linux\":/scripts:ro debian:bookworm bash /scripts/smoke.sh deb && docker run --rm -v \"$PWD/dist\":/out -v \"$PWD/scripts/linux\":/scripts:ro debian:bookworm bash /scripts/smoke.sh appimage",
    "signing:create": "bash scripts/mac/make-signing-cert.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@fontsource/michroma": "^5.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "lucide-static": "^1.61.0",
    "playwright-core": "^1.64.1"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "three": "^0.181.2"
  },
  "author": "GitDonkey",
  "build": {
    "appId": "dev.gitdonkey.app",
    "productName": "GitDonkey",
    "copyright": "GitDonkey",
    "directories": {
      "output": "dist/release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "package.json",
      "!**/.impeccable/**",
      "!**/*.md",
      "!node_modules/three/examples/**",
      "!node_modules/three/src/**",
      "!node_modules/three/build/three.cjs",
      "!node_modules/three/build/three.core.js",
      "!node_modules/three/build/three.module.js",
      "!node_modules/three/build/three.webgpu*",
      "!node_modules/three/build/three.tsl*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "GitDonkey"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GitDonkey",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "GitDonkey-Setup-${version}-${arch}.${ext}"
    },
    "toolsets": {
      "nsis": "1.2.1",
      "appimage": "1.0.3"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "artifactName": "GitDonkey-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "GitDonkey ${version}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "executableName": "gitdonkey",
      "synopsis": "A free, open-source desktop Git client",
      "description": "A free, open-source desktop Git client: commit graph, staging, merges and conflict resolution in a patched-modular-synth skin.",
      "maintainer": "GitDonkey <noreply@gitdonkey.com>",
      "artifactName": "GitDonkey-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "GitDonkey"
        }
      }
    },
    "deb": {
      "depends": [
        "git",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2 | libasound2t64"
      ]
    },
    "appImage": {
      "artifactName": "GitDonkey-${version}-linux-${arch}.${ext}",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "afterSign": "scripts/mac/after-sign.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NathanCart/gitdonkey.git"
  },
  "homepage": "https://github.com/NathanCart/gitdonkey",
  "bugs": {
    "url": "https://github.com/NathanCart/gitdonkey/issues"
  }
}
